<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/jarvis_dark_bg"
    android:padding="16dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="J.A.R.V.I.S."
            android:textColor="@color/jarvis_cyan"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tvSystemStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STANDBY"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/jarvis_gold"
            android:background="@drawable/arc_reactor_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Permissions Row (Compact) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Accessibility"
            android:textSize="11sp"
            android:textColor="@color/jarvis_dark_bg"
            android:backgroundTint="@color/jarvis_cyan"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnDnd"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="DND Access"
            android:textSize="11sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/jarvis_card_bg"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnWriteSettings"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Settings"
            android:textSize="11sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/jarvis_card_bg"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnApiKey"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="API Key"
            android:textSize="11sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/jarvis_card_bg" />
    </LinearLayout>

    <!-- Banking Shield Button -->
    <Button
        android:id="@+id/btnShield"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="🛡️ Banking Shield: SETUP (Click for PC command)"
        android:textSize="11sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/jarvis_card_bg"
        android:layout_marginBottom="6dp" />

    <!-- Auto-Unlock Screen & App Lock Passwords Setup -->
    <Button
        android:id="@+id/btnLockSetup"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="🔐 Auto-Unlock &amp; Passwords Setup"
        android:textSize="11sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/jarvis_card_bg"
        android:layout_marginBottom="6dp" />

    <!-- App Auto-Update Row/Button -->
    <Button
        android:id="@+id/btnCheckUpdate"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="🔄 Check for App Updates"
        android:textSize="11sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/jarvis_card_bg"
        android:layout_marginBottom="6dp" />

    <!-- Personal Owner Voice Lock (Sirf Meri Awaaz) -->
    <Button
        android:id="@+id/btnVoiceLock"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="🎙️ MY VOICE LOCK: OFF (Tap to Train)"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:textColor="@color/jarvis_cyan"
        android:backgroundTint="@color/jarvis_card_bg"
        android:layout_marginBottom="6dp" />

    <!-- Action Bar: Permanent 24/7 Mic Start/Stop Toggle -->
    <Button
        android:id="@+id/btnTalk"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="▶  START ALWAYS-ON MIC"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/jarvis_dark_bg"
        android:backgroundTint="@color/jarvis_gold"
        android:layout_marginBottom="8dp" />

    <!-- Manual Command Input (Fallback) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/etCommandInput"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:hint="Type command (e.g. call Manish on whatsapp)"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@color/jarvis_card_bg"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSendCommand"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="Run"
            android:textColor="@color/jarvis_dark_bg"
            android:backgroundTint="@color/jarvis_cyan" />
    </LinearLayout>

    <!-- Live Real-Time Logs Console Header + Copy/Clear Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LIVE LOGS:"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDownloadLogs"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="⬇ Save .txt"
            android:textSize="10sp"
            android:textColor="@color/jarvis_dark_bg"
            android:backgroundTint="@color/green_active"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minHeight="0dp"
            android:layout_marginEnd="5dp" />

        <Button
            android:id="@+id/btnCopyLogs"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="📋 Copy"
            android:textSize="10sp"
            android:textColor="@color/jarvis_dark_bg"
            android:backgroundTint="@color/jarvis_cyan"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minHeight="0dp"
            android:layout_marginEnd="5dp" />

        <Button
            android:id="@+id/btnClearLogs"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Clear"
            android:textSize="10sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/jarvis_card_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="#05080E"
        app:cardElevation="2dp">

        <ScrollView
            android:id="@+id/scrollLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[System]: J.A.R.V.I.S. Core initialized.\n[System]: Ready for voice or text commands."
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textIsSelectable="true"
                android:typeface="monospace" />
        </ScrollView>
    </androidx.cardview.widget.CardView>

</LinearLayout>
