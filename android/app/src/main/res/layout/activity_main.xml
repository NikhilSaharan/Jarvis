<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/jarvis_dark_bg"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="J.A.R.V.I.S."
        android:textColor="@color/jarvis_cyan"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Autonomous Android Operating System"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <!-- Status Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/jarvis_card_bg"
        app:cardElevation="4dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Checking permissions..."
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAccessibilityStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Accessibility Service: Inactive"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvDndStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Do Not Disturb Policy: Inactive"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvOverlayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Floating Arc-Reactor: Inactive"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Permission Buttons -->
    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_enable_accessibility"
        android:textColor="@color/jarvis_dark_bg"
        android:backgroundTint="@color/jarvis_cyan"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnDnd"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_enable_dnd"
        android:textColor="@color/white"
        android:backgroundTint="@color/jarvis_card_bg"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnOverlay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_enable_overlay"
        android:textColor="@color/white"
        android:backgroundTint="@color/jarvis_card_bg"
        android:layout_marginBottom="16dp" />

    <!-- API Key Input -->
    <EditText
        android:id="@+id/etApiKey"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Gemini API Key (Optional / Saved)"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/jarvis_card_bg"
        android:inputType="textPassword"
        android:layout_marginBottom="16dp" />

    <!-- Action / Talk Button -->
    <Button
        android:id="@+id/btnTalk"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/btn_test_voice"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/jarvis_dark_bg"
        android:backgroundTint="@color/jarvis_gold" />

</LinearLayout>
